FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    HOME=/tmp/naftamon-home \
    XDG_RUNTIME_DIR=/tmp/naftamon-runtime \
    NAFTAMON_CONFIG=/lab-state/config/naftamon.ini \
    QT_X11_NO_MITSHM=1 \
    LIBGL_ALWAYS_SOFTWARE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    python3 \
    qmake6 \
    qt6-base-dev \
    qt6-multimedia-dev \
    qt6-qpa-plugins \
    libgl-dev \
    libglx-dev \
    libopengl-dev \
    libxcb-cursor0 \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    xterm \
    xfonts-base \
    fonts-dejavu-core \
    dbus-x11 \
    x11-utils \
    && rm -rf /var/lib/apt/lists/*

COPY docker/dev-entrypoint.sh /usr/local/bin/naftamon-dev-entrypoint
RUN chmod +x /usr/local/bin/naftamon-dev-entrypoint

WORKDIR /workspace
EXPOSE 6080
ENTRYPOINT ["/usr/local/bin/naftamon-dev-entrypoint"]
