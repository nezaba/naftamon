# Host port exposed by Docker Desktop.
WEB_PORT=8080

# Safe default: only this computer can connect. Set to a private LAN IP to accept
# Desktop webhooks from another trusted computer, then restrict Windows Firewall.
BIND_ADDRESS=127.0.0.1

# A source is offline after this many seconds without a snapshot. Set above the
# NaftaMon Desktop Gateway interval, which is not included in its JSON payload.
OFFLINE_AFTER_SECONDS=900

# Maximum HTTP request body size (8 MiB).
MAX_REQUEST_BYTES=8388608

# Keep alert transition history for this many days. Use 0 to disable cleanup.
HISTORY_RETENTION_DAYS=90
