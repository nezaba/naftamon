# Host port exposed by Docker Desktop.
WEB_PORT=8080

# Safe default: only this computer can connect. Set to a private LAN IP to accept
# Desktop webhooks from another trusted computer, then restrict Windows Firewall.
BIND_ADDRESS=127.0.0.1

# A source is offline after this many seconds without a snapshot. Set above the
# NaftaMon Desktop Gateway interval, which is not included in its JSON payload.
OFFLINE_AFTER_SECONDS=900

# Una fuente se puede eliminar manualmente tras este tiempo sin snapshots.
# No elimina fuentes automáticamente.
SOURCE_INACTIVE_AFTER_SECONDS=86400

# Maximum HTTP request body size for a legacy uncompressed snapshot (64 MiB).
# Gzip requests use a separate 8 MiB compressed limit and 128 MiB decoded limit.
MAX_REQUEST_BYTES=67108864
MAX_COMPRESSED_REQUEST_BYTES=8388608
MAX_DECOMPRESSED_REQUEST_BYTES=134217728

# Keep alert transition history for this many days. Use 0 to disable cleanup.
HISTORY_RETENTION_DAYS=90

# Destinos privados para Gotify, ntfy o HTTP. Dejar vacío salvo que necesites
# notificaciones hacia una red LAN concreta (ejemplo: 192.168.1.0/24).
NOTIFICATION_ALLOWED_DESTINATION_CIDRS=

# Directorio local, fuera de Git, con notification.key. Para pruebas aisladas,
# cambiar a otra carpeta sin reutilizar la clave de producción.
NOTIFICATION_KEY_DIR=./.local
