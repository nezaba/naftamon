# Solo para un proyecto Compose de pruebas aislado; no usar con datos reales.
BIND_ADDRESS=127.0.0.1
WEB_PORT=18080
OFFLINE_AFTER_SECONDS=5
SOURCE_INACTIVE_AFTER_SECONDS=86400
MAX_REQUEST_BYTES=8388608
HISTORY_RETENTION_DAYS=90
# Adaptar al CIDR privado de la red Docker del laboratorio si es diferente.
NOTIFICATION_ALLOWED_DESTINATION_CIDRS=172.16.0.0/12
NOTIFICATION_KEY_DIR=./.test-local
